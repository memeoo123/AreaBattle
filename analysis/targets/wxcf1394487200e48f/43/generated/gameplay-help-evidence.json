[
  {
    "id": "StrategyDes_1",
    "text": "每个城堡最多只有3条出兵路线，当你的出兵路线大于敌人时，将会使敌人防不胜防",
    "status": "confirmed-as-in-game-help-text; runtime-unverified"
  },
  {
    "id": "StrategyDes_2",
    "text": "城堡的出兵速度会随城堡的等级提升而增加，但只有一条出兵路线的时候，出兵的速度最快",
    "status": "confirmed-as-in-game-help-text; runtime-unverified"
  },
  {
    "id": "StrategyDes_3",
    "text": "进攻路线上的小兵会根据攻击和生命值进行碰撞，生命值为0时会消失；此时骑兵和盾兵拥有更大的优势",
    "status": "confirmed-as-in-game-help-text; runtime-unverified"
  },
  {
    "id": "StrategyDes_4",
    "text": "己方的小兵行进到己方的城堡时，会根据小兵的支援点数为己方城堡升级，同时会消失；此时盾兵拥有更大的优势",
    "status": "confirmed-as-in-game-help-text; runtime-unverified"
  },
  {
    "id": "StrategyDes_5",
    "text": "己方的小兵行进到敌方的城堡时，会根据小兵的入侵点数对敌方城堡造成伤害，同时会消失；此时骑兵拥有更大的优势",
    "status": "confirmed-as-in-game-help-text; runtime-unverified"
  },
  {
    "id": "StrategyDes_6",
    "text": "当你拥有3座城堡时，试试将他们的出兵路线首尾相连，这样可以使每座城堡更快的升级",
    "status": "confirmed-as-in-game-help-text; runtime-unverified"
  },
  {
    "id": "StrategyDes_7",
    "text": "当城堡的等级达到MAX时，所有经过该城堡的兵将会沿着出兵路线再次出击",
    "status": "confirmed-as-in-game-help-text; runtime-unverified"
  },
  {
    "id": "StrategyDes_8",
    "text": "当对局中有无人占领的骑兵城堡或者盾兵城堡时，尽可能在你的敌人行动之前全力占领它们，即使你可能会丢掉手上的普通城堡，但是这样你将获得更大的回报",
    "status": "confirmed-as-in-game-help-text; runtime-unverified"
  },
  {
    "id": "StrategyDes_9",
    "text": "当场上对局异常焦灼时，使用英雄技能可以更快的打破僵局，获得优势",
    "status": "confirmed-as-in-game-help-text; runtime-unverified"
  },
  {
    "id": "StrategyDes_10",
    "text": "箭塔会对圆形范围的所有敌人造成伤害，占领一座箭塔，它会对你后续的进攻和防守都起到至关重要的帮助",
    "status": "confirmed-as-in-game-help-text; runtime-unverified"
  }
]
