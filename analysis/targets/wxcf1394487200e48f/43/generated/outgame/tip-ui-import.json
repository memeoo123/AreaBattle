              "data": "{\"m_GameObject\": {\"m_FileID\": 0, \"m_PathID\": 5275241250569402494}, \"m_Enabled\": 1, \"m_Script\": {\"m_FileID\": 0, \"m_PathID\": -7978266203517415465}, \"m_Name\": \"\", \"m_Material\": {\"m_FileID\": 0, \"m_PathID\": 0}, \"m_Color\": {\"r\": 0.24313725531101227, \"g\": 0.24313725531101227, \"b\": 0.24313725531101227, \"a\": 1.0}, \"m_RaycastTarget\": false, \"m_RaycastPadding\": {\"x\": 0.0, \"y\": 0.0, \"z\": 0.0, \"w\": 0.0}, \"m_Maskable\": false, \"m_OnCullStateChanged\": {\"m_PersistentCalls\": {\"m_Calls\": []}}, \"m_FontData\": {\"m_Font\": {\"m_FileID\": 0, \"m_PathID\": 6544835752251692798}, \"m_FontSize\": 35, \"m_FontStyle\": 0, \"m_BestFit\": false, \"m_MinSize\": 10, \"m_MaxSize\": 35, \"m_Alignment\": 4, \"m_AlignByGeometry\": false, \"m_RichText\": true, \"m_HorizontalOverflow\": 0, \"m_VerticalOverflow\": 0, \"m_LineSpacing\": 1.0}, \"m_Text\": \"1.在活动期间内，进行关卡战斗获得积分，累计积分到达一定等级可获得丰厚奖励；\\r\\n2.开通超级通行证后获得的积分翻倍，可直接领取特殊通行证的奖励而无需观看激励视频。\"}",
