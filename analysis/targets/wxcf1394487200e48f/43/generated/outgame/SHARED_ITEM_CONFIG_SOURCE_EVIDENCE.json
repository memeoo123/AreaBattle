  "metadataScript": "analysis/generate_shared_item_schemas.py",
  "criticalEvidence": [
    "Original ItemConfigMgr4534 constructor34551 creates fields8/12/16/20/32/36 only. Package/reward group dictionaries remain null. get_Instance34554 creates/publishes instance without InitMgr. Restored explicit owner slot preserves this separation.",
